# Copy to terraform.tfvars (gitignored) and fill in real values.
# This repository is public - never commit the populated file.

project_name    = "mccarthy"
subscription_id = "REPLACE_WITH_SUBSCRIPTION_ID" # az account show --query id -o tsv
location        = "eastus2"
cost_center     = "REPLACE_WITH_COST_CENTER"

# Object ID of the mccarthy-github-actions SP. NOT the App/Client ID.
# Fetch: az ad sp show --id <appId> --query id -o tsv
gh_actions_sp_object_id = "REPLACE_WITH_SP_OBJECT_ID"

# Object IDs of human operators that need full secret read/write.
# Fetch your own: az ad signed-in-user show --query id -o tsv
operator_object_ids = [
  # "REPLACE_WITH_YOUR_OBJECT_ID",
]
