# Terraform
.terraform/
*.tfstate
*.tfstate.*
tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Variable files may carry subscription/tenant/object IDs and SSH public keys.
# This repository is public - only the .example templates are tracked.
*.tfvars
!*.tfvars.example
*.auto.tfvars

# Local backend config (contains storage account names)
backend.hcl
!backend.hcl.example

# NOTE: .terraform.lock.hcl is deliberately NOT ignored. Provider versions are
# pinned in git so every operator and CI run resolves the same binaries.

# Packer
packer_cache/
*.pkrvars.hcl
!*.pkrvars.hcl.example

# macOS
.DS_Store

# IDE
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log

# Permanently untracked, by decision on 2026-08-21. Not a hold, not a TODO.
# This repository commits its operational docs deliberately; this file is the
# standing exception. Its developer-side half (ddev start, ddev refresh-local,
# ddev pull-assets) has never been executed by anyone, and an unrun runbook in a
# public repo invites people to follow it. The lead developer will write their
# own onboarding document. This file stays a local operator reference only.
# Do not remove this line and do not commit the file.
docs/developer-onboarding.md
